# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored and read only at runtime — nothing here is committed.

# Your JBVNL portal password (shared across your accounts)
JBVNL_PASSWORD=

# Optional per-account password overrides:
# JBVNL_PW_<accountNumber>=

# Where bills are filed. Each account gets a subfolder "<account> (<Label>)".
BILLS_BASE=/path/to/your/Electricity Bills

# Your accounts as  account:Label  pairs, comma-separated.
# Example: JBVNL_ACCOUNTS=100000000001:Home,100000000002:Shop
JBVNL_ACCOUNTS=

# Optional Telegram run notifications (or set these in ~/.config/whatsapp-mcp/bridge.env)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
